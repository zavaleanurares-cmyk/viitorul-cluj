{
  "name": "locker-room",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w @club/shared",
    "test": "npm run test -w @club/shared",
    "stack:start": "node tools/local-stack/start.mjs",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "test:rls": "tsx scripts/test-rls.ts && tsx scripts/test-rls-lot.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:types": "node scripts/gen-types.mjs",
    "db:seed-club": "tsx scripts/seed-club.ts",
    "db:seed-library": "tsx scripts/seed-library.ts"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15"
  },
  "type": "module"
}
