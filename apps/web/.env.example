# --- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cheia de serviciu: DOAR pe server (crearea conturilor, sarcini programate). Nu o expune niciodată în browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicație ------------------------------------------------------------------
# Adresa publică a aplicației (folosită în invitații și e-mailuri)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Numele afișat înainte de autentificare și la instalarea ca aplicație (PWA)
NEXT_PUBLIC_APP_NAME=Vestiar

# --- Sarcini programate ------------------------------------------------------------
# Secret cerut de /api/cron (antet: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- E-mail (opțional; fără cheie, notificările rămân doar în aplicație) ----------------
RESEND_API_KEY=
EMAIL_FROM="Vestiar <notificari@exemplu.ro>"
