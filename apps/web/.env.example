# --- Bază de date (Postgres) -------------------------------------------------------
# Pe Vercel, integrarea Neon (Storage -> Neon) pune singură aceste două variabile.
# Local: `npm run stack:start` scrie DATABASE_URL în tools/local-stack/.data/env.
DATABASE_URL=postgres://utilizator:parola@gazda/baza
DATABASE_URL_UNPOOLED=postgres://utilizator:parola@gazda/baza

# --- Fișiere (Vercel Blob, depozit privat) ---------------------------------------------
# Pe Vercel, conectarea depozitului Blob la proiect pune singură variabilele necesare
# (BLOB_STORE_ID sau BLOB_READ_WRITE_TOKEN). Local nu e nevoie: fișierele stau pe disc.

# --- Aplicație ------------------------------------------------------------------
# Adresa publică a aplicației (folosită în linkurile de invitație și în e-mailuri)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Numele afișat înainte de autentificare și la instalarea ca aplicație (PWA)
NEXT_PUBLIC_APP_NAME="Locker Room"

# --- Sarcini programate ------------------------------------------------------------
# Secret cerut de /api/cron (antet: Authorization: Bearer <CRON_SECRET>). Vercel îl trimite automat.
CRON_SECRET=

# --- E-mail (opțional; fără cheie, notificările rămân în aplicație, iar linkurile de
# invitație se copiază de mână din ecranul de administrare) -------------------------------
RESEND_API_KEY=
EMAIL_FROM="Locker Room <notificari@exemplu.ro>"

# --- Plăți online ---------------------------------------------------------------------
# Până la alegerea operatorului real există doar operatorul de test (nu mișcă bani). În dezvoltare e pornit;
# în producție doar cu PAYMENTS_TEST_MODE=1 (pilot), altfel un părinte și-ar putea marca taxa plătită fără bani.
PAYMENTS_TEST_MODE=
# Secretul cu care se semnează webhook-ul operatorului de test (opțional; fără el, unul aleator pe proces).
PAYMENTS_WEBHOOK_SECRET=
